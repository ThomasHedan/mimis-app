# ─────────────────────────────────────────────────────────────────────────────
# MimisApp — variables d'environnement
# En local : copier ce fichier en `.env.local` et remplir les valeurs.
# En production : les saisir dans Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Base de données Postgres (Neon). Prendre la chaîne "pooled" du dashboard Neon.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Clé de signature des cookies de session. 32 caractères minimum.
# Générer avec :  openssl rand -base64 32
AUTH_SECRET="remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum"

# Les deux comptes de l'app, en JSON sur une seule ligne.
#  - id           : identifiant STABLE, stocké en base (created_by, user_id…).
#                   Ne jamais le changer une fois des données créées.
#  - email        : identifiant de connexion (insensible à la casse).
#  - display_name : nom affiché dans l'app.
#  - password     : hash scrypt — JAMAIS le mot de passe en clair.
#                   Générer avec :  npm run hash-password
APP_USERS='[{"id":"thomas","email":"thomas@exemple.fr","display_name":"Thomas","password":"scrypt:32768:8:1:...:..."},{"id":"mimi","email":"mimi@exemple.fr","display_name":"Mimi","password":"scrypt:32768:8:1:...:..."}]'

# Notifications push web (VAPID). Générer avec :
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Secret partagé avec le workflow GitHub qui déclenche le résumé quotidien.
# Générer avec :  openssl rand -hex 32
CRON_SECRET=""  # obligatoire : sans lui, la route /api/cron refuse tout appel
